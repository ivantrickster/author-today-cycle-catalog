{
  "manifest_version": 3,
  "name": "Каталог циклов для Author.Today",
  "version": "0.16.1",
  "description": "Неофициальный каталог, поиск и анализ удержания аудитории в циклах Author.Today.",
  "incognito": "split",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://author.today/*", "https://api.author.today/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "current.html",
    "default_title": "Статистика открытого цикла",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://author.today/work/series/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
